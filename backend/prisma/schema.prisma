generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String            @map("password_hash")
  firstName        String            @map("first_name")
  lastName         String            @map("last_name")
  roleId           String            @map("role_id")
  role             Role              @relation(fields: [roleId], references: [id])
  tickets          Ticket[]
  ticketReports    TicketReport[]    @relation("TicketReportSubmitter")
  maintenanceTasks MaintenanceTask[]
  notifications    Notification[]
  siteAssignments  SiteAssignment[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // Super Admin, Engineer, Site Operator
  permissions String[]
  users       User[]

  @@map("roles")
}

model Site {
  id              String           @id @default(uuid())
  name            String
  location        String
  latitude        Float?
  longitude       Float?
  overallHealth   Float            @default(100.0) @map("overall_health")
  rooms           Room[]
  expertRules     ExpertRule[]
  notifications   Notification[]
  userAssignments SiteAssignment[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("sites")
}

model SiteAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  siteId    String   @map("site_id")
  site      Site     @relation(fields: [siteId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, siteId])
  @@map("site_assignments")
}

model Room {
  id             String      @id @default(uuid())
  siteId         String      @map("site_id")
  site           Site        @relation(fields: [siteId], references: [id])
  name           String
  targetTemp     Float       @map("target_temp")
  targetHumidity Float       @map("target_humidity")
  equipments     Equipment[]

  @@map("rooms")
}

model Equipment {
  id               String            @id @default(uuid())
  roomId           String            @map("room_id")
  room             Room              @relation(fields: [roomId], references: [id])
  name             String
  type             String // UPS, CRAC, Generator, Battery
  status           String            @default("healthy") // healthy, warning, critical, offline
  telemetry        Telemetry[]
  alarms           Alarm[]
  tickets          Ticket[]
  maintenanceTasks MaintenanceTask[]

  @@map("equipments")
}

model Telemetry {
  id          String    @id @default(uuid())
  equipmentId String    @map("equipment_id")
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  metricType  String    @map("metric_type") // temperature, voltage, humidity
  value       Float
  timestamp   DateTime  @default(now())

  @@index([equipmentId, timestamp])
  @@map("telemetry")
}

model Alarm {
  id          String    @id @default(uuid())
  equipmentId String    @map("equipment_id")
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  severity    String // warning, critical
  description String
  active      Boolean   @default(true)
  tickets     Ticket[]
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("alarms")
}

model Ticket {
  id          String        @id @default(uuid())
  alarmId     String?       @map("alarm_id")
  alarm       Alarm?        @relation(fields: [alarmId], references: [id])
  equipmentId String        @map("equipment_id")
  equipment   Equipment     @relation(fields: [equipmentId], references: [id])
  title       String
  status      String        @default("pending") // pending, assigned, inProgress, resolved, closed
  priority    String // low, medium, high
  source      String        @default("manual") // manual, alarm_manual, alarm_auto
  assignedTo  String?       @map("assigned_to")
  assignee    User?         @relation(fields: [assignedTo], references: [id])
  report      TicketReport?
  dueDate     DateTime?     @map("due_date")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("tickets")
}

model TicketReport {
  id            String   @id @default(uuid())
  ticketId      String   @unique @map("ticket_id")
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  submittedById String   @map("submitted_by_id")
  submitter     User     @relation("TicketReportSubmitter", fields: [submittedById], references: [id])
  isFailure     Boolean  @map("is_failure")
  failureDomain String   @map("failure_domain")
  rootCause     String   @map("root_cause")
  actionTaken   String   @map("action_taken")
  serviceImpact String   @map("service_impact")
  currentState  String   @map("current_state")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("ticket_reports")
}

model MaintenanceTask {
  id            String    @id @default(uuid())
  equipmentId   String    @map("equipment_id")
  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  title         String
  status        String    @default("pending") // pending, inProgress, completed
  assignedTo    String?   @map("assigned_to")
  assignee      User?     @relation(fields: [assignedTo], references: [id])
  scheduledDate DateTime  @map("scheduled_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("maintenance_tasks")
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String
  category  String
  tags      String[]
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("knowledge_base")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  siteId    String?  @map("site_id")
  site      Site?    @relation(fields: [siteId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read, createdAt])
  @@index([siteId])
  @@map("notifications")
}

model ExpertRule {
  id          String   @id @default(uuid())
  name        String
  description String
  parameter   String
  threshold   Float
  unit        String
  siteId      String?  @map("site_id")
  site        Site?    @relation(fields: [siteId], references: [id])
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("expert_rules")
}
